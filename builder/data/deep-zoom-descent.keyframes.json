    "mappings": {
      "linear": {
        "g": "nu",
        "L": 600,
        "phase": 0.1,
        "why": "a compromise: no one L serves both ends, since nu spans about 4 across the top frame and 2e4 across the bottom one; at 600 the top is one colour outside the boundary and the deep spirals shade toward texture"
      },
      "log": {
        "g": "ln nu",
        "L": 0.25,
        "phase": 0,
        "why": "about 2.4 cycles across the top frame, 5 across the target, and about 1 across the flattest middle frames (k6 to k12)"
      },
      "power": {
        "g": "nu^alpha",
        "alpha": 0.3,
        "L": 0.6,
        "phase": 0,
        "why": "between linear and log: at alpha 0.4 the top frame lost its bands, and lower than 0.3 approaches log"
      }
    }
  },
