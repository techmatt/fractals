scratch/
artifacts/

# This machine's own settings: where the companion code repository is checked out.
# No absolute path is committed here, so the one that exists is untracked.
local.toml

# Prompt working copies. Prompts live in C:\Code\fractal-drive-sync\prompts and
# never land in this repo; a copy dropped here for a session stays untracked.
/website_*.md

# The wasm crate's build tree. `engine.wasm` beside the page is the committed
# artifact; this is the several hundred megabytes cargo needs to produce it.
explorer/engine-wasm/target/

# Builder output that is regenerated rather than reviewed.
builder/__pycache__/
__pycache__/
*.egg-info/
.venv/
.ruff_cache/
.pytest_cache/

# Visual Studio's per-user solution state. Toolchain noise, the same shape as the
# caches above: it appeared in the working tree on its own and `git add -A` would
# have committed it.
.vs/

# OS junk
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
._*
